{
  "name": "@blue-jump/storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf node_modules .turbo coverage"
  },
  "dependencies": {
    "server-only": "catalog:"
  },
  "devDependencies": {
    "@blue-jump/eslint-config": "workspace:*",
    "@blue-jump/typescript-config": "workspace:*",
    "@blue-jump/vitest-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
